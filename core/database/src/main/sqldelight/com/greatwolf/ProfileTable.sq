CREATE TABLE profile (
    user_id TEXT PRIMARY KEY,
    full_name TEXT,
    user_name TEXT,
    data_of_birth TEXT,
    email TEXT NOT NULL,
    phone TEXT,
    image_url TEXT
);

insertProfile:
INSERT INTO profile(full_name, user_name, data_of_birth, email, phone, image_url)
VALUES (?, ?, ?, ?, ?, ?);


getProfileById:
SELECT profile.*
FROM profile
WHERE user_id = ?;

updateProfileById:
UPDATE profile
SET full_name = ?, user_name = ?, data_of_birth = ?, email = ?, phone = ?
WHERE user_id = ?;

deleteProfileById:
DELETE FROM profile
WHERE user_id = ?;
